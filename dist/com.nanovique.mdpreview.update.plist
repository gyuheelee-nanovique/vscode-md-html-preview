<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS auto-update LaunchAgent for CONSUMER machines.
  Every 6 hours and at login, re-runs install.sh: pull the repo cache, and reinstall the
  packaged .vsix through the VS Code CLI when the version changed.

  Install:
    cp "${XDG_DATA_HOME:-$HOME/.local/share}/vscode-md-html-preview/dist/com.nanovique.mdpreview.update.plist" \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.nanovique.mdpreview.update.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.nanovique.mdpreview.update.plist

  If the checkout lives somewhere else, set MDPREVIEW_HOME in the command below to match.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nanovique.mdpreview.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>"${MDPREVIEW_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/vscode-md-html-preview}/dist/install.sh"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>StandardOutPath</key>
  <string>/tmp/mdpreview-update.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/mdpreview-update.log</string>
</dict>
</plist>
